PORT=5000
NODE_ENV=development

# Local development database. Set real values in .env (never commit it).
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# Required in production; use a long random secret.
JWT_SECRET=

# Comma-separated browser origins (no paths), e.g. http://localhost:5173,https://shop.example.com
CLIENT_URL=http://localhost:5173

# Migration safety
RUN_REMOTE_MIGRATIONS=false
SKIP_SEEDS=false
