<!DOCTYPE html>
<html lang="vi">
<%- include('partials/head') %>
<body class="bg-slate-50 text-slate-900 antialiased h-screen overflow-hidden">
  <div id="admin-app" v-cloak class="h-screen w-screen flex overflow-hidden">
    <!-- Desktop Sidebar (Permanently anchored, never scrolls with content) -->
    <%- include('partials/sidebar') %>

    <!-- Main Content Wrapper (Anchored header + independent scrolling body) -->
    <div class="flex-1 flex flex-col min-w-0 h-screen overflow-hidden bg-slate-50">
      <!-- Top Bar & Mobile Subnav -->
      <%- include('partials/topbar') %>

      <!-- Main Tabs Container: Vertical scrollbar always visible -->
      <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-slate-50 always-scrollbar">
        <!-- TAB 1: DASHBOARD -->
        <%- include('partials/tab-dashboard') %>

        <!-- TAB 2: ORDERS & KANBAN -->
        <%- include('partials/tab-orders') %>

        <!-- TAB 3: PRODUCTS & MENU -->
        <%- include('partials/tab-products') %>

        <!-- TAB 4: CUSTOMERS & SHIPPERS -->
        <%- include('partials/tab-customers-shippers') %>

        <!-- TAB 5: SETTINGS & COUPONS -->
        <%- include('partials/tab-settings') %>
      </main>
    </div>

    <!-- Modals & Hidden Thermal 80mm Print Area -->
    <%- include('partials/modals') %>
  </div>

  <!-- Vue 3 Setup Script & Socket.io Realtime -->
  <%- include('partials/scripts') %>
</body>
</html>
