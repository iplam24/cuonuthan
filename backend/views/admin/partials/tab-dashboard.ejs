<!-- TAB 1: DASHBOARD -->
<section v-if="currentTab === 'dashboard'" class="space-y-6 fade-in duration-200">
  <!-- Executive Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-2">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-2.5">
        <span class="w-8 h-8 rounded-xl bg-gradient-to-tr from-rose-600 to-rose-400 text-white flex items-center justify-center text-sm shadow-glow-rose">
          <i class="fa-solid fa-chart-pie"></i>
        </span>
        <span>Trung Tâm Chỉ Huy & Doanh Thu Bếp</span>
      </h1>
      <p class="text-xs text-slate-500 mt-1 font-medium">Báo cáo hiệu suất vận hành thời gian thực, đồng bộ tự động từ Storefront & POS</p>
    </div>

    <div class="flex items-center gap-2.5">
      <button
        @click="refreshDashboard"
        :disabled="loading.dashboard"
        class="px-4 py-2 rounded-xl bg-white border border-slate-200 hover:border-slate-300 text-slate-800 text-xs font-bold shadow-xs flex items-center gap-2 transition active:scale-95 disabled:opacity-60"
        title="Tải lại số liệu"
      >
        <i class="fa-solid fa-arrows-rotate text-rose-600" :class="{ 'animate-spin': loading.dashboard }"></i>
        <span>{{ loading.dashboard ? 'Đang cập nhật...' : 'Làm mới số liệu' }}</span>
      </button>
      <span v-if="lastUpdated" class="text-[11px] font-mono font-bold text-slate-400 bg-slate-100 px-2.5 py-1.5 rounded-xl border border-slate-200 hidden sm:inline">
        {{ lastUpdated.toLocaleTimeString('vi-VN') }}
      </span>
    </div>
  </div>

  <!-- Operational Telemetry Bar -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
    <div class="p-3 bg-gradient-to-r from-emerald-500/10 to-teal-500/5 rounded-2xl border border-emerald-500/20 flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl bg-emerald-500 text-white flex items-center justify-center text-sm shadow-xs font-bold">
        <i class="fa-solid fa-fire-burner"></i>
      </div>
      <div class="min-w-0">
        <div class="text-[11px] font-bold text-emerald-800 uppercase tracking-wide">Trạng thái bếp</div>
        <div class="text-xs font-extrabold text-emerald-950 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
          <span>Bếp Út Hân Sẵn Sàng (Live Ops)</span>
        </div>
      </div>
    </div>

    <div class="p-3 bg-gradient-to-r from-blue-500/10 to-indigo-500/5 rounded-2xl border border-blue-500/20 flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl bg-blue-600 text-white flex items-center justify-center text-sm shadow-xs font-bold">
        <i class="fa-solid fa-clock-rotate-left"></i>
      </div>
      <div class="min-w-0">
        <div class="text-[11px] font-bold text-blue-800 uppercase tracking-wide">Thời gian ra món</div>
        <div class="text-xs font-extrabold text-blue-950 font-mono">
          {{ settingsForm.delivery_time || '25–35 phút' }} (Chuẩn bị nhanh)
        </div>
      </div>
    </div>

    <div class="p-3 bg-gradient-to-r from-purple-500/10 to-pink-500/5 rounded-2xl border border-purple-500/20 flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl bg-purple-600 text-white flex items-center justify-center text-sm shadow-xs font-bold">
        <i class="fa-solid fa-motorcycle"></i>
      </div>
      <div class="min-w-0">
        <div class="text-[11px] font-bold text-purple-800 uppercase tracking-wide">Đội ngũ Shipper</div>
        <div class="text-xs font-extrabold text-purple-950">
          {{ shippersList.length || 3 }} tài xế liên kết giao nóng
        </div>
      </div>
    </div>
  </div>

  <div v-if="errors.dashboard" class="rounded-2xl border border-red-200 bg-red-50 p-4 text-xs text-red-800 flex items-start gap-3">
    <i class="fa-solid fa-triangle-exclamation mt-0.5 text-base"></i>
    <div class="flex-1">{{ errors.dashboard }}</div>
    <button @click="loadDashboard" class="underline font-bold">Thử lại</button>
  </div>

  <!-- 4 Luxury Bento KPI Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- Today Revenue -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-soft hover:shadow-card hover:border-rose-300 transition-all duration-300 flex flex-col justify-between group relative overflow-hidden">
      <div class="absolute -right-6 -top-6 w-24 h-24 bg-rose-500/5 rounded-full blur-xl group-hover:bg-rose-500/10 transition-colors"></div>
      <div>
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-extrabold text-slate-500 uppercase tracking-wider">Doanh thu hôm nay</span>
          <span class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-rose-600 to-rose-400 text-white flex items-center justify-center text-base shadow-glow-rose group-hover:scale-110 transition-transform">
            <i class="fa-solid fa-sack-dollar"></i>
          </span>
        </div>
        <div class="text-2xl sm:text-3xl font-black text-rose-600 mt-3 tracking-tight font-mono">
          {{ formatVND(stats?.today?.revenue || 0) }}
        </div>
      </div>
      <div class="text-[11px] text-emerald-700 mt-3 font-bold flex items-center justify-between pt-2 border-t border-slate-100">
        <span class="flex items-center gap-1.5"><i class="fa-solid fa-circle-check"></i><span>Đơn hoàn tất</span></span>
        <span class="font-mono text-slate-500 text-[10px]">AOV: {{ formatVND(stats?.today?.orders ? Math.round((stats?.today?.revenue || 0) / stats.today.orders) : 0) }}</span>
      </div>
    </div>

    <!-- Today Orders -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-soft hover:shadow-card hover:border-blue-300 transition-all duration-300 flex flex-col justify-between group relative overflow-hidden">
      <div class="absolute -right-6 -top-6 w-24 h-24 bg-blue-500/5 rounded-full blur-xl group-hover:bg-blue-500/10 transition-colors"></div>
      <div>
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-extrabold text-slate-500 uppercase tracking-wider">Số đơn hôm nay</span>
          <span class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-blue-600 to-cyan-500 text-white flex items-center justify-center text-base shadow-sm group-hover:scale-110 transition-transform">
            <i class="fa-solid fa-receipt"></i>
          </span>
        </div>
        <div class="text-2xl sm:text-3xl font-black text-slate-900 mt-3 tracking-tight font-mono">
          {{ stats?.today?.orders || 0 }} <span class="text-sm font-bold text-slate-400">đơn</span>
        </div>
      </div>
      <div class="text-[11px] text-blue-700 mt-3 font-bold flex items-center gap-1.5 pt-2 border-t border-slate-100">
        <i class="fa-solid fa-globe"></i>
        <span>Đơn qua Web & MiniApp</span>
      </div>
    </div>

    <!-- Pending Orders with Urgent Pulse Alert -->
    <div
      class="p-5 rounded-2xl border transition-all duration-300 flex flex-col justify-between group relative overflow-hidden cursor-pointer"
      :class="(stats?.status_counts?.pending || 0) > 0 ? 'bg-amber-50/70 border-amber-300 shadow-glow-amber' : 'bg-white border-slate-200/80 shadow-soft hover:shadow-card'"
      @click="goToPendingOrders"
      title="Nhấn để xem các đơn đang chờ duyệt"
    >
      <div>
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-extrabold text-slate-500 uppercase tracking-wider">Đơn chờ duyệt</span>
          <span
            class="w-11 h-11 rounded-2xl flex items-center justify-center text-base shadow-sm transition-transform group-hover:scale-110"
            :class="(stats?.status_counts?.pending || 0) > 0 ? 'bg-amber-500 text-white animate-bounce' : 'bg-slate-100 text-amber-700'"
          >
            <i class="fa-solid fa-bell"></i>
          </span>
        </div>
        <div class="text-2xl sm:text-3xl font-black mt-3 tracking-tight font-mono" :class="(stats?.status_counts?.pending || 0) > 0 ? 'text-amber-700' : 'text-slate-800'">
          {{ stats?.status_counts?.pending || 0 }} <span class="text-sm font-bold text-slate-400">đơn</span>
        </div>
      </div>
      <div class="text-[11px] mt-3 font-bold flex items-center justify-between pt-2 border-t border-amber-200/50" :class="(stats?.status_counts?.pending || 0) > 0 ? 'text-amber-800' : 'text-slate-500'">
        <span class="flex items-center gap-1.5"><i class="fa-solid fa-kitchen-set"></i><span>Cần bếp duyệt ngay</span></span>
        <span class="text-[10px] text-amber-700 underline">Xử lý ngay →</span>
      </div>
    </div>

    <!-- Month Revenue -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-soft hover:shadow-card hover:border-purple-300 transition-all duration-300 flex flex-col justify-between group relative overflow-hidden">
      <div class="absolute -right-6 -top-6 w-24 h-24 bg-purple-500/5 rounded-full blur-xl group-hover:bg-purple-500/10 transition-colors"></div>
      <div>
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-extrabold text-slate-500 uppercase tracking-wider">Doanh thu tháng này</span>
          <span class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-purple-600 to-indigo-500 text-white flex items-center justify-center text-base shadow-sm group-hover:scale-110 transition-transform">
            <i class="fa-solid fa-calendar-check"></i>
          </span>
        </div>
        <div class="text-2xl sm:text-3xl font-black text-slate-900 mt-3 tracking-tight font-mono">
          {{ formatVND(stats?.month_revenue || stats?.month?.revenue || 0) }}
        </div>
      </div>
      <div class="text-[11px] text-purple-700 mt-3 font-bold flex items-center gap-1.5 pt-2 border-t border-slate-100">
        <i class="fa-solid fa-chart-line"></i>
        <span>Doanh số tích lũy tháng</span>
      </div>
    </div>
  </div>

  <!-- Realtime Order Pipeline Multi-Segment Progress Strip -->
  <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/80 shadow-xs space-y-3">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <i class="fa-solid fa-diagram-project text-primary text-xs"></i>
        <h3 class="font-extrabold text-xs text-slate-900 uppercase tracking-wider">Tiến Độ Điều Phối Toàn Hệ Thống</h3>
      </div>
      <button @click="currentTab = 'orders'" class="text-xs font-bold text-rose-600 hover:underline flex items-center gap-1">
        <span>Xem Bảng Kanban</span>
        <i class="fa-solid fa-arrow-right text-[10px]"></i>
      </button>
    </div>

    <!-- Segmented Multi-Color Progress Bar -->
    <div class="w-full h-3.5 bg-slate-100 rounded-full overflow-hidden flex p-0.5 gap-0.5 border border-slate-200">
      <div
        class="bg-amber-500 rounded-full transition-all duration-500"
        :style="{ width: Math.max(5, (Number(stats?.status_counts?.pending || 0) * 10)) + '%' }"
        title="Chờ duyệt"
      ></div>
      <div
        class="bg-blue-500 rounded-full transition-all duration-500"
        :style="{ width: Math.max(5, (Number(stats?.status_counts?.confirmed || 0) * 10)) + '%' }"
        title="Đã nhận"
      ></div>
      <div
        class="bg-purple-500 rounded-full transition-all duration-500"
        :style="{ width: Math.max(5, (Number(stats?.status_counts?.preparing || 0) * 10)) + '%' }"
        title="Đang nấu"
      ></div>
      <div
        class="bg-orange-500 rounded-full transition-all duration-500"
        :style="{ width: Math.max(5, (Number(stats?.status_counts?.delivering || 0) * 10)) + '%' }"
        title="Đang giao"
      ></div>
      <div
        class="bg-emerald-500 rounded-full transition-all duration-500 flex-1"
        title="Hoàn thành"
      ></div>
    </div>

    <!-- Legend -->
    <div class="flex flex-wrap items-center justify-between gap-2 text-[11px] pt-1 font-semibold text-slate-600">
      <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-amber-500 inline-block"></span>Chờ duyệt: <strong>{{ stats?.status_counts?.pending || 0 }}</strong></span>
      <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-blue-500 inline-block"></span>Đã nhận: <strong>{{ stats?.status_counts?.confirmed || 0 }}</strong></span>
      <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-purple-500 inline-block"></span>Bếp nấu: <strong>{{ stats?.status_counts?.preparing || 0 }}</strong></span>
      <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-orange-500 inline-block"></span>Đang giao: <strong>{{ stats?.status_counts?.delivering || 0 }}</strong></span>
      <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span>Hoàn tất: <strong>{{ stats?.status_counts?.completed || 0 }}</strong></span>
    </div>
  </div>

  <!-- 7-Day Revenue Trend Chart & Top Bestsellers -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- 7-Day Chart -->
    <div class="lg:col-span-7 bg-white p-6 rounded-2xl border border-slate-200/80 shadow-soft space-y-4">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3.5">
        <h3 class="font-extrabold text-sm text-slate-900 uppercase tracking-wider flex items-center gap-2">
          <span class="w-7 h-7 rounded-lg bg-rose-50 border border-rose-200 text-rose-600 flex items-center justify-center text-xs">
            <i class="fa-solid fa-chart-column"></i>
          </span>
          <span>Biểu Đồ Doanh Thu 7 Ngày Gần Nhất</span>
        </h3>
        <span class="text-[11px] text-slate-600 font-mono font-bold bg-slate-100 px-2.5 py-1 rounded-xl border border-slate-200">VNĐ · Thực thu</span>
      </div>

      <div class="h-64 flex items-end justify-between gap-3 pt-8 px-3 bg-gradient-to-b from-slate-50 to-white rounded-2xl border border-slate-100">
        <div
          v-for="(day, idx) in (stats?.revenue_7_days || [])"
          :key="idx"
          class="flex-1 flex flex-col items-center gap-2 group relative"
        >
          <!-- Tooltip on hover -->
          <div class="text-[10px] font-mono font-bold text-slate-900 bg-white/95 px-2 py-0.5 rounded-lg shadow-sm border border-slate-200 group-hover:border-rose-500 group-hover:text-rose-600 transition">
            {{ formatVNDShort(day.revenue) }}
          </div>
          <!-- Bar with luxury gradient -->
          <div
            class="w-full bg-gradient-to-t from-rose-600 via-rose-500 to-rose-400 rounded-t-xl transition-all duration-300 group-hover:brightness-110 shadow-xs"
            :style="{ height: getChartHeight(day.revenue) + 'px', minHeight: '14px' }"
          ></div>
          <!-- Date Label -->
          <div class="text-[11px] font-bold text-slate-500 group-hover:text-slate-900 whitespace-nowrap">
            {{ day.date }}
          </div>
        </div>
      </div>
    </div>

    <!-- Top 5 Bestsellers -->
    <div class="lg:col-span-5 bg-white p-6 rounded-2xl border border-slate-200/80 shadow-soft space-y-4">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3.5">
        <h3 class="font-extrabold text-sm text-slate-900 uppercase tracking-wider flex items-center gap-2">
          <span class="w-7 h-7 rounded-lg bg-amber-50 border border-amber-200 text-amber-600 flex items-center justify-center text-xs">
            <i class="fa-solid fa-crown"></i>
          </span>
          <span>Top Món Cuốn Bán Chạy</span>
        </h3>
        <span class="text-[11px] text-amber-700 font-bold bg-amber-50 px-2 py-0.5 rounded-lg border border-amber-200">Bán chạy nhất</span>
      </div>

      <div class="space-y-2.5">
        <div
          v-for="(p, idx) in (stats?.top_products || [])"
          :key="idx"
          class="flex items-center justify-between p-3 rounded-2xl border border-slate-100 hover:bg-rose-50/40 hover:border-rose-200 transition-all duration-200 text-xs group"
        >
          <div class="flex items-center gap-3 min-w-0">
            <span
              class="w-8 h-8 rounded-xl font-extrabold flex items-center justify-center text-xs shadow-xs shrink-0"
              :class="idx === 0 ? 'bg-gradient-to-tr from-amber-500 to-yellow-400 text-amber-950 ring-2 ring-amber-300/60 shadow-glow-amber/50' : (idx === 1 ? 'bg-slate-200 text-slate-800' : (idx === 2 ? 'bg-amber-100 text-amber-800' : 'bg-slate-100 text-slate-600'))"
            >
              {{ idx === 0 ? '👑' : idx + 1 }}
            </span>
            <span class="font-bold text-slate-900 group-hover:text-rose-600 transition truncate">{{ p.product_name || p.name }}</span>
          </div>
          <span class="font-mono font-bold text-rose-600 text-sm shrink-0">{{ p.total_sold || 0 }} <span class="text-[10px] font-normal text-slate-400">phần</span></span>
        </div>

        <div v-if="!stats?.top_products || stats.top_products.length === 0" class="text-center py-8 text-xs text-slate-400 italic">
          Chưa có dữ liệu món bán chạy hôm nay
        </div>
      </div>
    </div>
  </div>
</section>
