<!-- TAB 1: DASHBOARD -->
<section v-if="currentTab === 'dashboard'" class="space-y-6 fade-in duration-200">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-2">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight flex items-center gap-2.5">
        <i class="fa-solid fa-chart-pie text-primary"></i>
        <span>Tổng Quan Tình Hình Bếp & Doanh Thu</span>
      </h1>
      <p class="text-xs text-slate-500 mt-0.5 font-medium">Số liệu thời gian thực được đồng bộ trực tiếp từ hệ thống gọi món</p>
    </div>

    <div class="flex items-center gap-2">
      <button
        @click="refreshDashboard"
        :disabled="loading.dashboard"
        class="px-4 py-2 rounded-xl bg-white border border-slate-200 text-slate-900 text-xs font-bold hover:bg-slate-50 shadow-sm flex items-center gap-2 transition active:scale-95 disabled:opacity-60"
        title="Tải lại số liệu"
      >
        <i class="fa-solid fa-rotate" :class="{ 'animate-spin': loading.dashboard }"></i>
        <span>{{ loading.dashboard ? 'Đang tải...' : 'Cập nhật số liệu' }}</span>
      </button>
      <span v-if="lastUpdated" class="text-[11px] text-gray-500 hidden sm:inline">Cập nhật lúc {{ lastUpdated.toLocaleTimeString('vi-VN') }}</span>
    </div>
  </div>

  <div v-if="errors.dashboard" class="rounded-xl border border-red-200 bg-red-50 p-4 text-xs text-red-800 flex items-start gap-3">
    <i class="fa-solid fa-triangle-exclamation mt-0.5"></i>
    <div class="flex-1">{{ errors.dashboard }}</div>
    <button @click="loadDashboard" class="underline font-bold">Thử lại</button>
  </div>

  <!-- 4 Luxury KPI Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- Today Revenue -->
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between group">
      <div>
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-extrabold text-slate-500 uppercase tracking-wider">Doanh thu hôm nay</span>
          <span class="w-10 h-10 rounded-xl bg-rose-50 text-primary flex items-center justify-center text-base border border-slate-200 shadow-inner group-hover:scale-110 transition-transform">
            <i class="fa-solid fa-sack-dollar"></i>
          </span>
        </div>
        <div class="text-2xl sm:text-3xl font-bold text-primary mt-2 tracking-tight">
          {{ formatVND(stats?.today?.revenue || 0) }}
        </div>
      </div>
      <div class="text-[11px] text-emerald-700 mt-3 font-bold flex items-center gap-1.5 pt-2 border-t border-slate-100">
        <i class="fa-solid fa-circle-check"></i>
        <span>Tính từ đơn đã hoàn tất hôm nay</span>
      </div>
    </div>

    <!-- Today Orders -->
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between group">
      <div>
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-extrabold text-slate-500 uppercase tracking-wider">Số đơn hôm nay</span>
          <span class="w-10 h-10 rounded-xl bg-slate-100 text-blue-700 flex items-center justify-center text-base border border-blue-900/10 shadow-inner group-hover:scale-110 transition-transform">
            <i class="fa-solid fa-receipt"></i>
          </span>
        </div>
        <div class="text-2xl sm:text-3xl font-bold text-slate-900 mt-2 tracking-tight">
          {{ stats?.today?.orders || 0 }} <span class="text-sm font-semibold text-gray-500">đơn</span>
        </div>
      </div>
      <div class="text-[11px] text-blue-700 mt-3 font-bold flex items-center gap-1.5 pt-2 border-t border-slate-100">
        <i class="fa-solid fa-globe"></i>
        <span>Đơn đặt qua Storefront & Online</span>
      </div>
    </div>

    <!-- Pending Orders -->
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between group">
      <div>
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-extrabold text-slate-500 uppercase tracking-wider">Đơn chờ duyệt</span>
          <span class="w-10 h-10 rounded-xl bg-slate-100 text-amber-700 flex items-center justify-center text-base border border-slate-200 shadow-inner group-hover:scale-110 transition-transform">
            <i class="fa-solid fa-bell"></i>
          </span>
        </div>
        <div class="text-2xl sm:text-3xl font-bold text-amber-600 mt-2 tracking-tight">
          {{ stats?.status_counts?.pending || 0 }} <span class="text-sm font-semibold text-gray-500">đơn</span>
        </div>
      </div>
      <div class="text-[11px] text-amber-800 mt-3 font-bold flex items-center gap-1.5 pt-2 border-t border-slate-100">
        <i class="fa-solid fa-fire-burner"></i>
        <span>Cần bếp tiếp nhận xử lý ngay</span>
      </div>
    </div>

    <!-- Month Revenue -->
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between group">
      <div>
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-extrabold text-slate-500 uppercase tracking-wider">Doanh thu tháng này</span>
          <span class="w-10 h-10 rounded-xl bg-slate-100 text-purple-700 flex items-center justify-center text-base border border-purple-900/10 shadow-inner group-hover:scale-110 transition-transform">
            <i class="fa-solid fa-calendar-check"></i>
          </span>
        </div>
        <div class="text-2xl sm:text-3xl font-bold text-slate-900 mt-2 tracking-tight">
          {{ formatVND(stats?.month_revenue || stats?.month?.revenue || 0) }}
        </div>
      </div>
      <div class="text-[11px] text-gray-500 mt-3 font-bold flex items-center gap-1.5 pt-2 border-t border-slate-100">
        <i class="fa-solid fa-chart-simple"></i>
        <span>Tổng kết trong tháng hiện tại</span>
      </div>
    </div>
  </div>

  <!-- 7-Day Revenue Trend Chart & Top Bestsellers -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- 7-Day Chart -->
    <div class="lg:col-span-7 bg-white p-6 rounded-xl border border-slate-200 shadow-sm space-y-4">
      <div class="flex items-center justify-between border-b border-slate-200 pb-3">
        <h3 class="font-extrabold text-sm text-slate-900 uppercase tracking-wider flex items-center gap-2">
          <i class="fa-solid fa-chart-column text-accent"></i>
          <span>Biểu Đồ Doanh Thu 7 Ngày Gần Nhất</span>
        </h3>
        <span class="text-[11px] text-slate-500 font-bold bg-slate-50 px-2 py-0.5 rounded-lg border border-slate-200">VNĐ</span>
      </div>

      <div class="h-64 flex items-end justify-between gap-3 pt-8 px-2 bg-slate-50 rounded-xl border border-slate-100">
        <div
          v-for="(day, idx) in (stats?.revenue_7_days || [])"
          :key="idx"
          class="flex-1 flex flex-col items-center gap-2 group relative"
        >
          <!-- Tooltip on hover -->
          <div class="text-[10px] font-bold text-slate-900 bg-white/95 px-2 py-0.5 rounded-lg shadow-sm border border-slate-200 group-hover:border-primary group-hover:text-primary transition">
            {{ formatVNDShort(day.revenue) }}
          </div>
          <!-- Bar with luxury gradient -->
          <div
            class="w-full bg-primary rounded-t-xl transition-all duration-500 group-hover:brightness-110 shadow-sm"
            :style="{ height: getChartHeight(day.revenue) + 'px', minHeight: '12px' }"
          ></div>
          <!-- Date Label -->
          <div class="text-[11px] font-bold text-gray-500 group-hover:text-gray-900 whitespace-nowrap">
            {{ day.date }}
          </div>
        </div>
      </div>
    </div>

    <!-- Top 5 Bestsellers -->
    <div class="lg:col-span-5 bg-white p-6 rounded-xl border border-slate-200 shadow-sm space-y-4">
      <div class="flex items-center justify-between border-b border-slate-200 pb-3">
        <h3 class="font-extrabold text-sm text-slate-900 uppercase tracking-wider flex items-center gap-2">
          <i class="fa-solid fa-crown text-amber-500"></i>
          <span>Top Món Cuốn Bán Chạy Nhất</span>
        </h3>
        <span class="text-[11px] text-slate-500 font-bold bg-slate-50 px-2 py-0.5 rounded-lg border border-slate-200">Bán ra</span>
      </div>

      <div class="space-y-2.5">
        <div
          v-for="(p, idx) in (stats?.top_products || [])"
          :key="idx"
          class="flex items-center justify-between p-3 rounded-xl border border-slate-100 hover:bg-slate-50 hover:border-slate-300 transition text-xs group"
        >
          <div class="flex items-center gap-3">
            <span
              class="w-7 h-7 rounded-xl font-bold flex items-center justify-center text-xs shadow-xs"
              :class="idx === 0 ? 'bg-slate-700 text-white ring-2 ring-amber-300/40' : (idx === 1 ? 'bg-slate-300 text-slate-800' : (idx === 2 ? 'bg-amber-200 text-slate-700' : 'bg-gray-100 text-gray-600'))"
            >
              {{ idx + 1 }}
            </span>
            <span class="font-bold text-gray-900 group-hover:text-primary transition">{{ p.product_name || p.name }}</span>
          </div>
          <span class="font-bold text-primary text-sm">{{ p.total_sold || 0 }} <span class="text-[10px] font-normal text-gray-500">phần</span></span>
        </div>

        <div v-if="!stats?.top_products || stats.top_products.length === 0" class="text-center py-8 text-xs text-gray-400 italic">
          Chưa có dữ liệu món bán chạy
        </div>
      </div>
    </div>
  </div>
</section>
