<!-- 5. COUPON MODAL -->
<div v-if="showCouponModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm fade-in">
  <div class="bg-white rounded-xl max-w-md w-full p-6 space-y-4 text-xs shadow-lg">
    <div class="flex justify-between items-center border-b pb-3">
      <h3 class="font-bold text-sm text-gray-900 uppercase tracking-wider flex items-center gap-2">
        <i class="fa-solid fa-tag text-accent"></i>
        <span>Tạo Mã Giảm Giá Mới</span>
      </h3>
      <button @click="showCouponModal = false" class="w-7 h-7 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-600 flex items-center justify-center font-bold">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <form @submit.prevent="saveCouponForm" class="space-y-3">
      <div>
        <label class="block font-bold text-gray-700 mb-1">Mã khuyến mãi (*)</label>
        <input v-model="couponForm.code" type="text" placeholder="VD: GIAM30K" class="w-full px-3 py-2 rounded-xl border uppercase font-mono font-bold focus:border-primary outline-none" required />
      </div>
      <div>
        <label class="block font-bold text-gray-700 mb-1">Mô tả ngắn</label>
        <input v-model="couponForm.description" type="text" placeholder="Giảm 30.000đ cho đơn từ 200k" class="w-full px-3 py-2 rounded-xl border" />
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block font-bold text-gray-700 mb-1">Loại giảm (*)</label>
          <select v-model="couponForm.discount_type" class="w-full px-3 py-2 rounded-xl border font-bold">
            <option value="fixed_amount">Số tiền cố định (đ)</option>
            <option value="percentage">Phần trăm (%)</option>
          </select>
        </div>
        <div>
          <label class="block font-bold text-gray-700 mb-1">Mức giảm (*)</label>
          <input v-model.number="couponForm.discount_value" type="number" min="1" class="w-full px-3 py-2 rounded-xl border font-bold text-primary" required />
        </div>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block font-bold text-gray-700 mb-1">Đơn hàng tối thiểu (VNĐ)</label>
          <input v-model.number="couponForm.min_order_value" type="number" min="0" step="10000" class="w-full px-3 py-2 rounded-xl border font-bold" />
        </div>
        <div>
          <label class="block font-bold text-gray-700 mb-1">Giới hạn lượt dùng</label>
          <input v-model.number="couponForm.usage_limit" type="number" min="1" step="1" class="w-full px-3 py-2 rounded-xl border font-bold" />
        </div>
      </div>
      <div>
        <label class="block font-bold text-gray-700 mb-1">Ngày hết hạn</label>
        <input v-model="couponForm.end_date" type="datetime-local" class="w-full px-3 py-2 rounded-xl border font-bold" />
      </div>

      <div class="flex justify-end gap-2 pt-3 border-t">
        <button type="button" @click="showCouponModal = false" class="px-4 py-2 rounded-xl bg-gray-100 font-bold hover:bg-gray-200 transition">Hủy</button>
        <button type="submit" class="px-5 py-2 rounded-xl bg-primary text-white font-bold shadow hover:bg-primary-dark transition">Tạo Mã</button>
      </div>
    </form>
  </div>
</div>
