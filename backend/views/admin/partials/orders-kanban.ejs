<!-- KANBAN VIEW WITH HTML5 DRAG & DROP -->
<div v-if="orderViewMode === 'kanban'" class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-3.5 items-start overflow-x-auto pb-4">
  <div
    v-for="col in kanbanColumns"
    :key="col.status"
    class="kanban-dropzone bg-slate-100 rounded-xl p-3 border border-slate-200 shadow-xs flex flex-col transition min-h-[580px]"
    :class="col.status === 'pending' ? 'border-t-4 border-t-amber-500' :
            col.status === 'confirmed' ? 'border-t-4 border-t-blue-500' :
            col.status === 'preparing' ? 'border-t-4 border-t-purple-500' :
            col.status === 'delivering' ? 'border-t-4 border-t-orange-500' : 'border-t-4 border-t-emerald-500'"
    @dragover.prevent="onDragOver($event, col.status)"
    @dragleave="onDragLeave($event)"
    @drop="onDrop($event, col.status)"
  >
    <!-- Column Header -->
    <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-200 text-xs font-bold uppercase tracking-wider">
      <span class="flex items-center gap-2 text-slate-900">
        <i :class="col.icon" class="text-sm"></i>
        <span>{{ col.title }}</span>
      </span>
      <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold shadow-sm" :class="col.badgeClass">
        {{ getOrdersByStatus(col.status).length }}
      </span>
    </div>

    <!-- Column Card List -->
    <div class="space-y-3 flex-1 overflow-y-auto max-h-[calc(100vh-270px)] pr-0.5 always-scrollbar">
      <!-- Draggable Kanban Card -->
      <div
        v-for="ord in getVisibleOrdersByStatus(col.status)"
        :key="ord.id"
        class="kanban-card bg-white rounded-xl p-3.5 shadow-[0_2px_12px_-2px_rgba(92,45,23,0.06)] border border-slate-200 hover:shadow-lg hover:border-primary/30 transition-all duration-200 space-y-2.5 group"
        :class="{ 'is-dragging': draggingOrderId === ord.id }"
        draggable="true"
        @dragstart="onDragStart($event, ord)"
        @dragend="onDragEnd"
        @click="openOrderModal(ord)"
      >
        <div class="flex items-center justify-between">
          <span class="font-mono font-bold text-primary text-xs tracking-tight bg-red-50 px-2 py-0.5 rounded-lg border border-red-100">
            {{ ord.order_code }}
          </span>
          <span class="text-[10px] text-gray-400 font-semibold flex items-center gap-1">
            <i class="fa-regular fa-clock"></i>
            <span>{{ formatTime(ord.created_at) }}</span>
          </span>
        </div>

        <div>
          <div class="font-bold text-xs text-slate-900 line-clamp-1 group-hover:text-primary transition">{{ ord.customer_name }}</div>
          <div class="text-[11px] text-gray-500 font-mono font-semibold">{{ ord.customer_phone }}</div>
        </div>

        <!-- Items summary -->
        <div class="text-[11px] text-gray-700 line-clamp-2 bg-slate-50 p-2 rounded-xl border border-slate-200 leading-snug">
          <span v-for="(it, idx) in ord.items || []" :key="idx">
            <strong class="text-slate-700">{{ it.quantity }}x</strong> {{ it.product_name }}<span v-if="idx < (ord.items.length - 1)">, </span>
          </span>
        </div>

        <div class="flex items-center justify-between pt-1 border-t border-slate-100 text-xs">
          <span class="font-bold text-primary text-sm">{{ formatVND(ord.total_amount) }}</span>
          <span class="text-[10px] font-bold px-2 py-0.5 rounded-full" :class="ord.payment_status === 'paid' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-50 text-amber-800'">
            {{ ord.payment_status === 'paid' ? 'Đã TT' : 'Chưa TT' }}
          </span>
        </div>

        <!-- Quick Action Buttons -->
        <div class="pt-1.5 flex items-center gap-1.5" @click.stop>
          <button
            v-if="col.nextStatus"
            :disabled="isPending('order-' + ord.id)"
            @click="advanceStatus(ord.id, col.nextStatus)"
            class="flex-1 py-1.5 px-2 rounded-xl text-[11px] font-extrabold text-white transition text-center shadow-sm flex items-center justify-center gap-1.5 active:scale-95"
            :class="col.btnClass"
            :title="col.btnText"
          >
            <i :class="col.nextIcon"></i>
            <span>{{ col.btnText }}</span>
          </button>
          <button
            @click="triggerPosPrint(ord, 'receipt')"
            class="p-1.5 bg-slate-50 hover:bg-slate-100 text-slate-700 rounded-xl text-xs transition border border-slate-200"
            title="In hóa đơn POS 80mm"
          >
            <i class="fa-solid fa-print"></i>
          </button>
        </div>
      </div>

      <!-- Scale Solution: Notice & Expansion for Completed Column -->
      <div
        v-if="col.status === 'completed' && getOrdersByStatus('completed').length > 6"
        class="p-3 bg-white rounded-xl border border-dashed border-emerald-400 text-center space-y-1.5 text-xs shadow-xs"
      >
        <div class="text-[11px] text-gray-600 font-semibold">
          Đã hoàn tất <strong class="text-emerald-700 font-bold">{{ getOrdersByStatus('completed').length }}</strong> đơn.
        </div>
        <button
          @click="showAllCompleted = !showAllCompleted"
          class="text-[11px] font-bold text-emerald-700 hover:text-emerald-900 flex items-center justify-center gap-1 w-full underline"
        >
          <span>{{ showAllCompleted ? 'Thu gọn (chỉ hiện 6 đơn mới)' : `Xem thêm ${getOrdersByStatus('completed').length - 6} đơn cũ hơn` }}</span>
        </button>
        <button
          @click="viewCompletedInTable"
          class="text-[10px] text-gray-500 hover:text-primary block w-full mt-1 font-semibold"
        >
          Xem tất cả trong Bảng Danh Sách ➔
        </button>
      </div>

      <!-- Empty Column Placeholder -->
      <div
        v-if="getOrdersByStatus(col.status).length === 0"
        class="h-40 flex flex-col items-center justify-center text-center p-4 border-2 border-dashed border-slate-300 rounded-xl text-gray-400 text-xs"
      >
        <i class="fa-regular fa-folder-open text-2xl mb-1.5 text-slate-700/20"></i>
        <span class="font-medium">Chưa có đơn hàng</span>
      </div>
    </div>
  </div>
</div>
