<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  
  <!-- Font Be Vietnam Pro -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,600;1,700&display=swap" rel="stylesheet">

  <!-- Font Awesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Be Vietnam Pro"', 'sans-serif'],
          },
          colors: {
            primary: {
                DEFAULT: '#BE123C',
              dark: '#9F1239',
              light: '#E11D48'
            },
            accent: {
              DEFAULT: '#475569',
              dark: '#334155',
            },
            surface: {
              DEFAULT: '#FFFFFF',
              muted: '#F8FAFC'
            },
            ink: {
              DEFAULT: '#0F172A',
              muted: '#475569'
            }
          },
          boxShadow: {
            'soft': '0 4px 20px -2px rgba(184, 38, 30, 0.08), 0 2px 6px -2px rgba(0, 0, 0, 0.04)',
            'card': '0 10px 25px -5px rgba(38, 28, 22, 0.06)',
            'kanban': '0 4px 15px -3px rgba(0, 0, 0, 0.07)'
          }
        }
      }
    }
  </script>

  <!-- Axios CDN, Vue 3 & Socket.IO -->
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
  <script src="/socket.io/socket.io.js"></script>

  <style>
    body { font-family: 'Be Vietnam Pro', sans-serif; }
    [v-cloak] { display: none; }
    
    /* Luôn luôn hiện thanh cuộn dọc trên toàn hệ thống */
    html, body {
      height: 100%;
      margin: 0;
      padding: 0;
      background: #F8FAFC;
    }
    /* Scroll only where content needs it; avoid nested forced scroll containers. */
    .always-scrollbar { scrollbar-gutter: stable; }
    ::-webkit-scrollbar { width: 7px; height: 7px; }
    ::-webkit-scrollbar-track { background: #F1F5F9; }
    ::-webkit-scrollbar-thumb { background: #CBD5E1; border-radius: 999px; }
    ::-webkit-scrollbar-thumb:hover { background: #94A3B8; }
    * { scrollbar-width: thin; scrollbar-color: #CBD5E1 #F1F5F9; }
    button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, [role="button"]:focus-visible { outline: 2px solid rgba(190,18,60,.45); outline-offset: 2px; }
    @media (max-width: 767px) {
      main { padding: 0.875rem !important; }
      table { min-width: 680px; }
      .kanban-dropzone { min-width: 280px; min-height: 420px; }
    }

    /* Kanban Drag & Drop Styles */
    .kanban-dropzone.drag-over {
      background-color: #F1F5F9 !important;
      border: 2px dashed #BE123C !important;
    }
    .kanban-card {
      cursor: grab;
      user-select: none;
    }
    .kanban-card:active {
      cursor: grabbing;
    }
    .kanban-card.is-dragging {
      opacity: 0.35;
      transform: scale(0.96);
    }

    /* Limit admin product thumbnails strictly to prevent layout breaking */
    .admin-product-thumbnail,
    table img {
      width: 3.25rem !important;
      height: 3.25rem !important;
      max-width: 3.25rem !important;
      max-height: 3.25rem !important;
      object-fit: cover !important;
      flex-shrink: 0 !important;
      display: block !important;
    }

    @media print {
      body * { visibility: hidden; }
      #pos-print-area, #pos-print-area * { visibility: visible; }
      #pos-print-area {
        position: absolute;
        left: 0;
        top: 0;
        width: 80mm;
        margin: 0;
        padding: 0;
      }
    }
  </style>
</head>
