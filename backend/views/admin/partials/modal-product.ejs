<!-- 2. PRODUCT MODAL (ADD / EDIT) -->
<div v-if="showProductModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm fade-in">
  <div class="bg-white rounded-xl max-w-lg w-full p-6 space-y-4 text-xs max-h-[90vh] overflow-y-auto shadow-lg">
    <div class="flex justify-between items-center border-b pb-3">
      <h3 class="font-bold text-sm text-gray-900 uppercase tracking-wider flex items-center gap-2">
        <i class="fa-solid" :class="productEditingId ? 'fa-pen-to-square text-accent' : 'fa-plus text-primary'"></i>
        <span>{{ productEditingId ? 'Chỉnh Sửa Món Ăn' : 'Thêm Món Mới Vào Menu' }}</span>
      </h3>
      <button @click="showProductModal = false" class="w-7 h-7 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-600 flex items-center justify-center font-bold">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <form @submit.prevent="saveProductForm" class="space-y-3">
      <div>
        <label class="block font-bold text-gray-700 mb-1">Tên món ăn (*)</label>
        <input v-model="productForm.name" type="text" class="w-full px-3 py-2 rounded-xl border focus:border-primary outline-none" required />
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block font-bold text-gray-700 mb-1">Danh mục (*)</label>
          <select v-model="productForm.category_id" class="w-full px-3 py-2 rounded-xl border font-bold focus:border-primary outline-none" required>
            <option value="">-- Chọn danh mục --</option>
            <option v-for="c in categoriesList" :key="c.id" :value="c.id">{{ c.name }}</option>
          </select>
        </div>
        <div>
          <label class="block font-bold text-gray-700 mb-1">Đơn vị tính</label>
          <input v-model="productForm.unit" type="text" placeholder="phần, mẹt, đĩa" class="w-full px-3 py-2 rounded-xl border focus:border-primary outline-none" />
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block font-bold text-gray-700 mb-1">Giá bán (VNĐ) (*)</label>
          <input v-model.number="productForm.price" type="number" min="0" step="1000" class="w-full px-3 py-2 rounded-xl border font-bold text-primary focus:border-primary outline-none" required />
        </div>
        <div>
          <label class="block font-bold text-gray-700 mb-1">Giá gốc gạch ngang</label>
          <input v-model.number="productForm.original_price" type="number" min="0" step="1000" class="w-full px-3 py-2 rounded-xl border text-gray-500 focus:border-primary outline-none" />
        </div>
      </div>

      <div>
        <label class="block font-bold text-gray-700 mb-1">Đường dẫn ảnh</label>
          <input v-model="productForm.image_url" type="url" placeholder="/uploads/products/... hoặc https://..." class="w-full px-3 py-2 rounded-xl border focus:border-primary outline-none" />
          <input type="file" accept="image/*" @change="onProductImageChange" class="mt-2 w-full text-xs" aria-label="Chọn ảnh xem trước" />
          <img v-if="productImagePreview || productForm.image_url" :src="productImagePreview || productForm.image_url" alt="Xem trước ảnh món ăn" class="mt-2 h-24 w-24 rounded-xl object-cover border" @error="$event.target.style.display='none'" />
      </div>

      <div>
        <label class="block font-bold text-gray-700 mb-1">Mô tả ngắn</label>
        <textarea v-model="productForm.short_description" rows="2" class="w-full px-3 py-2 rounded-xl border focus:border-primary outline-none"></textarea>
      </div>

      <!-- Business Flags: Side dish rule, Featured, Out of stock -->
      <div class="p-3 bg-slate-50 rounded-xl border border-amber-200/70 space-y-2">
        <label class="flex items-center gap-2 cursor-pointer font-bold text-slate-900">
          <input type="checkbox" v-model="productForm.is_side_dish" :true-value="1" :false-value="0" class="w-4 h-4 rounded text-primary" />
          <span>Món Phụ / Kèm (Chỉ cho phép khách đặt khi đã chọn Món chính)</span>
        </label>

        <div class="flex items-center gap-4 pt-1 border-t border-amber-200/50">
          <label class="flex items-center gap-2 cursor-pointer font-bold text-gray-700">
            <input type="checkbox" v-model="productForm.is_featured" :true-value="1" :false-value="0" class="rounded text-amber-500" />
            <span>★ Món Bán Chạy</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer font-bold text-gray-700">
            <input type="checkbox" v-model="productForm.is_out_of_stock" :true-value="1" :false-value="0" class="rounded text-red-600" />
            <span>🔴 Đang Hết Hàng</span>
          </label>
        </div>
      </div>

      <div class="flex justify-end gap-2 pt-3 border-t">
        <button type="button" @click="showProductModal = false" class="px-4 py-2 rounded-xl bg-gray-100 font-bold hover:bg-gray-200 transition">Hủy</button>
        <button type="submit" class="px-5 py-2 rounded-xl bg-primary text-white font-bold shadow hover:bg-primary-dark transition">
          {{ productEditingId ? 'Cập Nhật Món' : 'Thêm Món' }}
        </button>
      </div>
    </form>
  </div>
</div>
