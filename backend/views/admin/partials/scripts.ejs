      const loading = reactive({ dashboard: false, orders: false, products: false, customers: false, shippers: false, coupons: false, settings: false });
      const errors = reactive({ dashboard: '', orders: '', products: '', customers: '', shippers: '', coupons: '', settings: '' });
      const lastUpdated = ref(null);

      // Data states
      const stats = ref(null);
      const ordersList = ref([]);
      const productsList = ref([]);
      const customersList = ref([]);
      const shippersList = ref([]);
      const couponsList = ref([]);
