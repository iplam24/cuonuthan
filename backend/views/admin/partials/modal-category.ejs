<!-- 3. CATEGORY MODAL -->
<div v-if="showCategoryModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm fade-in">
  <div class="bg-white rounded-xl max-w-md w-full p-6 space-y-4 text-xs max-h-[85vh] overflow-y-auto shadow-lg">
    <div class="flex justify-between items-center border-b pb-3">
      <h3 class="font-bold text-sm text-gray-900 uppercase tracking-wider flex items-center gap-2">
        <i class="fa-solid fa-folder-tree text-accent"></i>
        <span>Quản Lý Danh Mục Món</span>
      </h3>
      <button @click="showCategoryModal = false" class="w-7 h-7 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-600 flex items-center justify-center font-bold">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <form @submit.prevent="createCategorySubmit" class="flex gap-2">
      <input v-model="newCategoryName" type="text" placeholder="Tên danh mục mới..." class="flex-1 px-3 py-2 rounded-xl border focus:border-primary outline-none" required />
      <button type="submit" class="px-4 py-2 bg-primary text-white rounded-xl font-bold shadow hover:bg-primary-dark transition">Thêm</button>
    </form>

    <div class="divide-y divide-gray-100 border rounded-xl overflow-hidden max-h-60 overflow-y-auto">
      <div v-for="cat in categoriesList" :key="cat.id" class="p-3 flex items-center justify-between hover:bg-gray-50 gap-2">
        <template v-if="editingCategoryId === cat.id">
          <input v-model="categoryEditingName" type="text" class="flex-1 px-2 py-1 rounded-lg border text-xs outline-none focus:border-primary" @keyup.enter="saveCategoryEdit" />
          <button @click="saveCategoryEdit" class="px-2.5 py-1 rounded-lg bg-primary text-white font-bold text-[10px]">Lưu</button>
          <button @click="cancelCategoryEdit" class="px-2.5 py-1 rounded-lg bg-gray-100 text-gray-700 font-bold text-[10px]">Hủy</button>
        </template>
        <template v-else>
          <div class="flex-1">
            <div class="font-bold text-gray-800">{{ cat.name }}</div>
            <div class="text-[10px] text-gray-400 font-mono">{{ cat.slug }}</div>
          </div>
          <button @click="startEditCategory(cat)" class="p-1.5 hover:bg-slate-100 text-gray-600 hover:text-primary rounded-lg transition" title="Chỉnh sửa danh mục"><i class="fa-solid fa-pen-to-square"></i></button>
          <button @click="deleteCategory(cat)" class="p-1.5 hover:bg-red-50 text-red-500 hover:text-red-700 rounded-lg transition" title="Xóa danh mục"><i class="fa-solid fa-trash-can"></i></button>
        </template>
      </div>
    </div>
  </div>
</div>
