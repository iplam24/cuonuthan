<!-- TABLE VIEW (With Backend SQL Pagination) -->
<div v-else class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
  <div class="overflow-x-auto always-scrollbar">
    <table class="w-full text-left text-xs">
      <thead class="bg-slate-50 text-slate-900 font-bold border-b border-slate-200 uppercase tracking-wider">
        <tr>
          <th class="p-4">Mã đơn</th>
          <th class="p-4">Khách hàng</th>
          <th class="p-4">Điện thoại</th>
          <th class="p-4">Địa chỉ giao</th>
          <th class="p-4">Tổng tiền</th>
          <th class="p-4">Thanh toán</th>
          <th class="p-4">Trạng thái</th>
          <th class="p-4">Thời gian</th>
          <th class="p-4 text-right">Thao tác</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-amber-900/5">
        <tr
          v-for="ord in ordersList"
          :key="ord.id"
          class="hover:bg-slate-50 transition cursor-pointer group"
          @click="openOrderModal(ord)"
        >
          <td class="p-4 font-mono font-bold text-primary">
            <span class="px-2 py-0.5 bg-red-50 rounded-lg border border-red-100">{{ ord.order_code }}</span>
          </td>
          <td class="p-4 font-bold text-slate-900 group-hover:text-primary transition">{{ ord.customer_name }}</td>
          <td class="p-4 text-gray-600 font-mono font-bold">{{ ord.customer_phone }}</td>
          <td class="p-4 text-gray-600 max-w-xs truncate font-medium">{{ ord.delivery_address }}</td>
          <td class="p-4 font-bold text-primary text-sm">{{ formatVND(ord.total_amount) }}</td>
          <td class="p-4">
            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold" :class="ord.payment_status === 'paid' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-50 text-amber-800'">
              {{ ord.payment_status === 'paid' ? 'Đã thanh toán' : 'Chưa thanh toán' }}
            </span>
          </td>
          <td class="p-4">
            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase" :class="getStatusBadge(ord.status)">
              {{ getStatusText(ord.status) }}
            </span>
          </td>
          <td class="p-4 text-gray-500 font-medium">{{ formatDateTime(ord.created_at) }}</td>
          <td class="p-4 text-right" @click.stop>
            <div class="flex items-center justify-end gap-1.5">
              <button
                @click="triggerPosPrint(ord, 'receipt')"
                class="p-2 bg-slate-50 hover:bg-slate-100 text-slate-700 rounded-xl transition border border-slate-200"
                title="In hóa đơn POS 80mm"
              >
                <i class="fa-solid fa-print"></i>
              </button>
              <button
                @click="openOrderModal(ord)"
                class="px-3.5 py-1.5 bg-primary text-white rounded-xl font-bold hover:bg-primary-dark transition text-xs shadow-xs"
              >
                Chi tiết
              </button>
            </div>
          </td>
        </tr>

        <tr v-if="ordersList.length === 0">
          <td colspan="9" class="p-10 text-center text-gray-400 italic font-medium">
            Không tìm thấy đơn hàng nào phù hợp với bộ lọc
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- BACKEND PAGINATION BAR FOR ORDERS -->
  <div class="p-4 border-t border-slate-200 bg-slate-50 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
    <div class="text-gray-500 font-medium">
      Trang <strong>{{ orderPagination.page }}</strong> / <strong>{{ orderPagination.totalPages }}</strong> (Tổng <strong>{{ orderPagination.total }}</strong> đơn)
    </div>
    <div class="flex items-center gap-1.5">
      <button
        @click="changeOrderPage(orderPagination.page - 1)"
        :disabled="orderPagination.page <= 1"
        class="px-3.5 py-1.5 rounded-xl border border-slate-200 bg-white disabled:opacity-40 font-bold hover:bg-slate-50 transition shadow-sm"
      >
        ‹ Trang trước
      </button>
      <span class="px-3.5 py-1.5 rounded-xl bg-primary text-white font-bold shadow-xs">{{ orderPagination.page }}</span>
      <button
        @click="changeOrderPage(orderPagination.page + 1)"
        :disabled="orderPagination.page >= orderPagination.totalPages"
        class="px-3.5 py-1.5 rounded-xl border border-slate-200 bg-white disabled:opacity-40 font-bold hover:bg-slate-50 transition shadow-sm"
      >
        Trang sau ›
      </button>
    </div>
  </div>
</div>
