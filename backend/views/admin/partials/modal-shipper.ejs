<!-- 4. SHIPPER MODAL (ADD & EDIT) -->
<div v-if="showShipperModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm fade-in">
  <div class="bg-white rounded-xl max-w-md w-full p-6 space-y-4 text-xs shadow-lg">
    <div class="flex justify-between items-center border-b pb-3">
      <h3 class="font-bold text-sm text-gray-900 uppercase tracking-wider flex items-center gap-2">
        <i class="fa-solid" :class="shipperEditingId ? 'fa-user-pen text-accent' : 'fa-user-plus text-primary'"></i>
        <span>{{ shipperEditingId ? 'Chỉnh Sửa Tài Xế' : 'Thêm Tài Xế Mới' }}</span>
      </h3>
      <button @click="showShipperModal = false" class="w-7 h-7 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-600 flex items-center justify-center font-bold">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <form @submit.prevent="saveShipperForm" class="space-y-3">
      <div>
        <label class="block font-bold text-gray-700 mb-1">Họ và tên (*)</label>
        <input v-model="shipperForm.full_name" type="text" placeholder="Nguyễn Văn A" class="w-full px-3 py-2 rounded-xl border focus:border-primary outline-none font-semibold" required />
      </div>
      <div>
        <label class="block font-bold text-gray-700 mb-1">Số điện thoại (*)</label>
        <input v-model="shipperForm.phone" type="tel" placeholder="09xxxxxxxx" class="w-full px-3 py-2 rounded-xl border focus:border-primary outline-none font-mono" required />
      </div>
      <div>
        <label class="block font-bold text-gray-700 mb-1">Biển số xe máy</label>
        <input v-model="shipperForm.vehicle_plate" type="text" placeholder="59-X1 123.45" class="w-full px-3 py-2 rounded-xl border focus:border-primary outline-none font-mono" />
      </div>

      <div class="flex justify-end gap-2 pt-3 border-t">
        <button type="button" @click="showShipperModal = false" class="px-4 py-2 rounded-xl bg-gray-100 font-bold hover:bg-gray-200 transition">Hủy</button>
        <button type="submit" class="px-5 py-2 rounded-xl bg-primary text-white font-bold shadow hover:bg-primary-dark transition">
          {{ shipperEditingId ? 'Lưu Thay Đổi' : 'Thêm Tài Xế' }}
        </button>
      </div>
    </form>
  </div>
</div>
