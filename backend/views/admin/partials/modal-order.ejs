<!-- 1. ORDER DETAIL MODAL -->
<div v-if="activeOrder" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm fade-in" @click.self="activeOrder = null">
  <section role="dialog" aria-modal="true" aria-labelledby="order-detail-title" class="bg-white rounded-xl max-w-2xl w-full p-6 space-y-4 text-xs max-h-[90vh] overflow-y-auto shadow-lg">
    <div class="flex justify-between items-center border-b pb-3.5">
      <div>
        <div id="order-detail-title" class="text-[10px] text-gray-400 uppercase font-bold tracking-wider">Chi tiết đơn hàng</div>
        <div class="font-mono font-bold text-xl text-primary flex items-center gap-2">
          <span>{{ activeOrder.order_code }}</span>
          <span class="text-xs px-2.5 py-0.5 rounded-full uppercase" :class="getStatusBadge(activeOrder.status)">
            {{ getStatusText(activeOrder.status) }}
          </span>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button
          @click="triggerPosPrint(activeOrder, 'receipt')"
          class="px-3 py-1.5 bg-primary text-white rounded-xl font-bold hover:bg-primary-dark transition flex items-center gap-1.5 shadow-sm"
        >
          <i class="fa-solid fa-print"></i>
          <span>Hóa Đơn 80mm</span>
        </button>
        <button
          @click="triggerPosPrint(activeOrder, 'kitchen')"
          class="px-3 py-1.5 bg-slate-500 text-white rounded-xl font-bold hover:bg-amber-600 transition flex items-center gap-1.5 shadow-sm"
        >
          <i class="fa-solid fa-fire-burner"></i>
          <span>Phiếu Bếp</span>
        </button>
        <button
          @click="activeOrder = null"
          class="w-8 h-8 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-600 flex items-center justify-center font-bold transition"
          aria-label="Đóng chi tiết đơn"
        >
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
    </div>

    <div v-if="orderDetailLoading" class="py-10 text-center text-gray-500 text-xs font-semibold flex flex-col items-center gap-2">
      <i class="fa-solid fa-circle-notch fa-spin text-lg text-primary"></i>
      <span>Đang tải chi tiết đầy đủ...</span>
    </div>

    <div v-else class="space-y-3.5">
      <!-- Customer Info Card -->
      <div class="bg-gray-50 p-4 rounded-xl border border-gray-200/80 grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <span class="text-gray-400 font-bold block text-[10px] uppercase">Khách hàng</span>
          <span class="font-bold text-gray-900 text-sm">{{ activeOrder.customer_name }}</span>
          <span class="font-mono text-gray-600 block mt-0.5">{{ activeOrder.customer_phone }}</span>
        </div>
        <div>
          <span class="text-gray-400 font-bold block text-[10px] uppercase">Địa chỉ giao hàng</span>
          <span class="text-gray-800 font-medium">{{ activeOrder.delivery_address }}</span>
        </div>
        <div v-if="activeOrder.delivery_note" class="col-span-full bg-red-50 p-2.5 rounded-xl border border-red-200 text-red-700">
          <strong>Ghi chú:</strong> {{ activeOrder.delivery_note }}
        </div>
      </div>

      <!-- Items Table -->
      <div class="border border-gray-200 rounded-xl overflow-hidden">
        <div class="bg-gray-50 px-3.5 py-2 font-bold text-gray-600 border-b flex justify-between">
          <span>Món ăn đã đặt</span>
          <span>Thành tiền</span>
        </div>
        <div class="divide-y divide-gray-100 max-h-48 overflow-y-auto">
          <div v-for="it in activeOrder.items || []" :key="it.id" class="p-3 flex justify-between items-center hover:bg-gray-50/50">
            <div>
              <div class="font-bold text-gray-900">
                <span class="text-primary font-bold">{{ it.quantity }}x</span> {{ it.product_name }}
              </div>
              <div class="text-[10px] text-gray-400 font-mono">{{ formatVND(it.unit_price || it.price) }} / phần</div>
            </div>
            <span class="font-bold text-gray-900">{{ formatVND(it.total_price) }}</span>
          </div>
        </div>
      </div>

      <!-- Total & Payment Status -->
      <div class="flex justify-between items-center p-3 bg-slate-50 rounded-xl border border-slate-200 font-bold">
        <div>
          <span class="text-gray-600">Trạng thái thanh toán: </span>
          <span class="px-2 py-0.5 rounded-full text-[10px]" :class="activeOrder.payment_status === 'paid' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-50 text-amber-800'">
            {{ activeOrder.payment_status === 'paid' ? 'Đã thanh toán' : 'Chưa thanh toán' }} ({{ activeOrder.payment_method || 'COD' }})
          </span>
        </div>
        <div class="text-right">
          <span class="text-gray-500 mr-2 text-xs">Tổng tiền:</span>
          <span class="text-primary text-lg font-bold">{{ formatVND(activeOrder.total_amount) }}</span>
        </div>
      </div>

      <!-- Status Progression Actions & Cancellation -->
      <div class="p-3.5 bg-gray-50 rounded-xl border border-gray-200 space-y-3">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div class="font-bold text-gray-700 uppercase tracking-wider text-[10px]">Chuyển trạng thái tiếp theo</div>
          <div v-if="shippersList && shippersList.length" class="flex items-center gap-1.5">
            <label class="text-[10px] text-gray-500 font-semibold">Tài xế giao:</label>
            <select
              v-model="activeOrder.shipper_id"
              @change="assignShipperOrder(activeOrder)"
              class="px-2 py-1 rounded-lg border border-slate-200 bg-white text-xs text-slate-800 outline-none focus:border-primary"
            >
              <option :value="null">Chưa gán</option>
              <option v-for="shp in shippersList" :key="shp.id" :value="shp.id">{{ shp.full_name || shp.name }}</option>
            </select>
          </div>
        </div>
        <div class="flex flex-wrap gap-2">
          <button
            v-for="nextStatus in allowedOrderStatuses(activeOrder)"
            :key="nextStatus"
            v-show="nextStatus !== 'cancelled'"
            @click="advanceStatus(activeOrder.id, nextStatus); openOrderModal(activeOrder, true)"
            :disabled="isPending('order-' + activeOrder.id)"
            class="px-3.5 py-2 rounded-xl text-white font-bold transition flex items-center gap-1.5 shadow-sm active:scale-95 disabled:opacity-50"
            :class="nextStatus === 'confirmed' ? 'bg-primary hover:bg-primary-dark' : nextStatus === 'preparing' ? 'bg-purple-600 hover:bg-purple-700' : nextStatus === 'ready_for_pickup' ? 'bg-indigo-600 hover:bg-indigo-700' : nextStatus === 'delivering' ? 'bg-orange-600 hover:bg-orange-700' : 'bg-emerald-600 hover:bg-emerald-700'"
          >
            <i class="fa-solid fa-arrow-right"></i>
            <span>{{ getStatusText(nextStatus) }}</span>
          </button>
        </div>

        <div v-if="canMoveOrder(activeOrder, 'cancelled')" class="pt-2 border-t border-gray-200/80 space-y-2">
          <label class="block font-bold text-red-700 text-[11px]">Hủy đơn hàng (Yêu cầu lý do):</label>
          <div class="flex gap-2">
            <input v-model="cancelReasonInput" type="text" placeholder="Nhập lý do hủy..." class="flex-1 px-3 py-1.5 rounded-xl border border-red-200 text-xs outline-none focus:border-red-500" />
            <button @click="cancelActiveOrder" :disabled="cancelSubmitting || !cancelReasonInput.trim()" class="px-3 py-1.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-bold transition disabled:opacity-50">
              {{ cancelSubmitting ? 'Đang hủy...' : 'Xác nhận hủy đơn' }}
            </button>
          </div>
        </div>
      </div>

      <!-- History & Admin Notes -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-2">
        <!-- History timeline -->
        <div class="border border-gray-200 rounded-xl p-3 bg-white space-y-2">
          <div class="font-bold text-gray-700 uppercase tracking-wider text-[10px] flex items-center gap-1.5">
            <i class="fa-solid fa-timeline text-primary"></i>
            <span>Lịch sử trạng thái</span>
          </div>
          <div class="space-y-2 max-h-36 overflow-y-auto pr-1">
            <div v-for="h in activeOrderHistory" :key="h.id" class="text-[11px] border-l-2 border-primary/40 pl-2 py-0.5">
              <div class="font-bold text-gray-800">{{ getStatusText(h.new_status) }}</div>
              <div class="text-gray-500 text-[10px]">{{ h.note || '—' }} • {{ formatDateTime(h.created_at) }}</div>
            </div>
            <div v-if="!activeOrderHistory || activeOrderHistory.length === 0" class="text-gray-400 italic text-[10px]">Chưa có lịch sử trạng thái</div>
          </div>
        </div>

        <!-- Notes -->
        <div class="border border-gray-200 rounded-xl p-3 bg-white space-y-2">
          <div class="font-bold text-gray-700 uppercase tracking-wider text-[10px] flex items-center gap-1.5">
            <i class="fa-solid fa-sticky-note text-amber-600"></i>
            <span>Ghi chú nội bộ</span>
          </div>
          <div class="space-y-1.5 max-h-24 overflow-y-auto pr-1">
            <div v-for="n in activeOrderNotes" :key="n.id" class="text-[11px] bg-slate-50 p-1.5 rounded-lg border border-amber-200/50">
              <div class="font-medium text-gray-800">{{ n.note }}</div>
              <div class="text-[9px] text-gray-400 mt-0.5">{{ n.author_name || 'Admin' }} • {{ formatDateTime(n.created_at) }}</div>
            </div>
            <div v-if="!activeOrderNotes || activeOrderNotes.length === 0" class="text-gray-400 italic text-[10px]">Chưa có ghi chú nội bộ</div>
          </div>
          <form @submit.prevent="submitAdminNote" class="flex gap-1.5 pt-1">
            <input v-model="adminNoteInput" type="text" placeholder="Thêm ghi chú..." class="flex-1 px-2.5 py-1 rounded-lg border text-xs outline-none focus:border-primary" />
            <button type="submit" :disabled="adminNoteSubmitting || !adminNoteInput.trim()" class="px-2.5 py-1 rounded-lg bg-gray-800 hover:bg-black text-white font-bold transition disabled:opacity-50">Lưu</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</div>
