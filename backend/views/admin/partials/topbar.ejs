<!-- Top bar -->
<header class="h-14 bg-white border-b border-slate-200 flex items-center justify-between px-4 sm:px-6 z-20 flex-shrink-0">
  <div class="flex items-center gap-3">
    <span class="w-2 h-2 rounded-full bg-primary"></span>
    <span class="text-xs font-semibold text-slate-900 uppercase tracking-wide">
      {{ currentTab === 'dashboard' ? 'Tổng quan' :
         currentTab === 'orders' ? 'Đơn hàng & bếp' :
         currentTab === 'products' ? 'Thực đơn & kho' :
         currentTab === 'customers' ? 'Khách & shipper' : 'Cài đặt' }}
    </span>
    <button @click="toggleSound" class="ml-2 px-2.5 py-1.5 rounded-lg border text-[11px] font-medium flex items-center gap-1.5 transition" :class="soundEnabled ? 'bg-slate-50 border-slate-200 text-slate-700' : 'bg-white border-slate-200 text-slate-400'" :title="soundEnabled ? 'Tắt âm chuông' : 'Bật âm chuông'">
      <i class="fa-solid" :class="soundEnabled ? 'fa-bell text-slate-700' : 'fa-bell-slash text-slate-400'"></i>
      <span class="hidden sm:inline">{{ soundEnabled ? 'Chuông bật' : 'Chuông tắt' }}</span>
    </button>
  </div>

  <div class="flex items-center gap-3 sm:gap-4 text-xs text-slate-600">
    <div class="hidden lg:flex items-center gap-2 px-3 py-1.5 bg-slate-50 rounded-lg border border-slate-200 text-slate-700 text-xs font-mono">
      <i class="fa-regular fa-clock text-slate-500"></i><span>{{ liveClock }}</span>
    </div>
    <div class="flex items-center gap-3 pl-3 border-l border-slate-200">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-slate-900 text-white flex items-center justify-center text-xs"><i class="fa-solid fa-user-shield"></i></div>
        <span class="hidden sm:inline font-medium text-slate-900">{{ userName }}</span>
      </div>
      <button @click="logout" class="px-3 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 font-medium transition flex items-center gap-1.5 text-xs" title="Đăng xuất">
        <i class="fa-solid fa-arrow-right-from-bracket"></i><span class="hidden sm:inline">Đăng xuất</span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile nav -->
<div class="md:hidden flex bg-white border-b border-slate-200 overflow-x-auto text-xs font-medium px-2 py-2 gap-1 flex-shrink-0">
  <button @click="currentTab = 'dashboard'" class="px-3 py-1.5 rounded-lg whitespace-nowrap flex items-center gap-1.5" :class="currentTab === 'dashboard' ? 'bg-primary text-white' : 'text-slate-600 hover:text-slate-900'"><i class="fa-solid fa-chart-pie"></i><span>Tổng quan</span></button>
  <button @click="currentTab = 'orders'" class="px-3 py-1.5 rounded-lg whitespace-nowrap flex items-center gap-1.5" :class="currentTab === 'orders' ? 'bg-primary text-white' : 'text-slate-600 hover:text-slate-900'"><i class="fa-solid fa-fire-burner"></i><span>Đơn hàng</span><span v-if="newOrdersCount > 0" class="bg-rose-600 text-white text-[10px] px-1.5 rounded-full">+{{ newOrdersCount }}</span></button>
  <button @click="currentTab = 'products'" class="px-3 py-1.5 rounded-lg whitespace-nowrap flex items-center gap-1.5" :class="currentTab === 'products' ? 'bg-primary text-white' : 'text-slate-600 hover:text-slate-900'"><i class="fa-solid fa-utensils"></i><span>Thực đơn</span></button>
  <button @click="currentTab = 'customers'" class="px-3 py-1.5 rounded-lg whitespace-nowrap flex items-center gap-1.5" :class="currentTab === 'customers' ? 'bg-primary text-white' : 'text-slate-600 hover:text-slate-900'"><i class="fa-solid fa-motorcycle"></i><span>Khách & Shipper</span></button>
  <button @click="currentTab = 'settings'" class="px-3 py-1.5 rounded-lg whitespace-nowrap flex items-center gap-1.5" :class="currentTab === 'settings' ? 'bg-primary text-white' : 'text-slate-600 hover:text-slate-900'"><i class="fa-solid fa-sliders"></i><span>Cài đặt</span></button>
</div>
