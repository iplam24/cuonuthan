const bankSearchQuery = ref('');
const bankFilterType = ref('all');
const bankDropdownOpen = ref(false);
const testTransferAmount = ref(50000);
const customBankInputMode = ref(false);

const filteredBanks = computed(() => {
  const query = (bankSearchQuery.value || '').trim().toLowerCase();
  return VIETNAMESE_BANKS.filter(b => {
    if (bankFilterType.value === 'popular' && !b.popular) return false;
    if (bankFilterType.value === 'digital' && !b.isDigital) return false;
    if (!query) return true;
    return (
      b.id.toLowerCase().includes(query) ||
      b.shortName.toLowerCase().includes(query) ||
      b.name.toLowerCase().includes(query) ||
      b.bin.includes(query)
    );
  });
});

const selectedBankObj = computed(() => {
  const cur = (settingsForm.bank_id || '').trim().toUpperCase();
  return (
    VIETNAMESE_BANKS.find(b => b.id.toUpperCase() === cur || b.shortName.toUpperCase() === cur || b.bin === cur) || {
      id: settingsForm.bank_id || 'MB',
      bin: '970422',
      shortName: settingsForm.bank_id || 'Ngân hàng',
      name: 'Ngân hàng chuyển khoản',
      color: 'from-slate-700 to-slate-900'
    }
  );
});

const liveVietQrUrl = computed(() => {
  const bId = (settingsForm.bank_id || 'MB').trim();
  const accNo = (settingsForm.bank_account_no || '0988888888').trim();
  const accName = encodeURIComponent((settingsForm.bank_account_name || 'NGUYEN THI HAN').trim());
  const desc = encodeURIComponent('UH TEST');
  const amt = Math.round(Number(testTransferAmount.value) || 0);
  return `https://img.vietqr.io/image/${bId}-${accNo}-compact2.png?amount=${amt}&addInfo=${desc}&accountName=${accName}`;
});

function selectBank(b) {
  settingsForm.bank_id = b.id;
  bankDropdownOpen.value = false;
  customBankInputMode.value = false;
  notify(`Đã chọn ngân hàng ${b.shortName} (${b.id})`);
}

function copyBankNumber() {
  if (navigator.clipboard) {
    navigator.clipboard.writeText(settingsForm.bank_account_no || '');
    notify('Đã sao chép số tài khoản vào clipboard!');
  }
}

function printQrStandee() {
  const win = window.open('', '_blank', 'width=600,height=750');
  if (!win) return;
  win.document.write(`
    <!DOCTYPE html>
    <html>
      <head>
        <title>Standee VietQR - ${settingsForm.brand_name}</title>
        <style>
          body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; text-align: center; padding: 40px; margin: 0; background: #fff; }
          .card { border: 2px solid #be123c; border-radius: 24px; padding: 30px; max-width: 420px; margin: 0 auto; box-shadow: 0 10px 30px rgba(0,0,0,0.08); }
          .title { font-size: 22px; font-weight: 800; color: #be123c; margin-bottom: 4px; text-transform: uppercase; }
          .sub { font-size: 13px; color: #64748b; margin-bottom: 20px; }
          .qr-img { width: 280px; height: 280px; object-fit: contain; margin: 0 auto; border-radius: 12px; }
          .info { margin-top: 20px; background: #f8fafc; padding: 16px; border-radius: 16px; text-align: left; font-size: 13px; }
          .info-row { display: flex; justify-content: space-between; margin-bottom: 8px; }
          .label { color: #64748b; font-weight: 600; }
          .val { font-weight: 700; color: #0f172a; }
          @media print { body { padding: 0; } button { display: none; } }
        </style>
      </head>
      <body>
        <div class="card">
          <div class="title">${settingsForm.brand_name}</div>
          <div class="sub">Quét mã VietQR chuyển khoản thanh toán 24/7</div>
          <img src="${liveVietQrUrl.value}" class="qr-img" />
          <div class="info">
            <div class="info-row"><span class="label">Ngân hàng:</span><span class="val">${selectedBankObj.value.shortName} (${selectedBankObj.value.id})</span></div>
            <div class="info-row"><span class="label">Số tài khoản:</span><span class="val">${settingsForm.bank_account_no}</span></div>
            <div class="info-row"><span class="label">Chủ tài khoản:</span><span class="val">${settingsForm.bank_account_name}</span></div>
          </div>
          <button onclick="window.print()" style="margin-top:20px;padding:10px 24px;background:#be123c;color:#fff;border:none;border-radius:12px;font-weight:700;cursor:pointer;">In Standee Này</button>
        </div>
      </body>
    </html>
  `);
  win.document.close();
}
